{
  "name": "tdc-matchmaker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx scripts/generate-profiles.ts",
    "complexity": "node scripts/complexity.mjs",
    "prose": "! git grep -nIiE '—|\\bdelve|\\bleverag|seamless|\\brobust|comprehensive|in conclusion|important to note|designed to|as an ai' -- src scripts '*.md' ':!CONTRIBUTING.md'",
